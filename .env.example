# ISO Network — Variables d'environnement

# ============================================================
# DÉVELOPPEMENT LOCAL (.env.local — ne pas versionner)
# ============================================================

# Vercel Blob Storage token (obtenir sur vercel.com/dashboard/stores)
# Pour le développement local : créer un Blob store sur Vercel et copier le token ici
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxx

# Numéro WhatsApp de la boutique (format international sans +)
# Exemple Côte d'Ivoire : 22507XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=22500000000

# Mot de passe de l'espace admin (changez-le impérativement !)
ADMIN_PASSWORD=isonetwork2024

# ============================================================
# NOTES IMPORTANTES
# ============================================================
# 1. Copiez ce fichier en .env.local et remplissez vos vraies valeurs
# 2. .env.local est dans .gitignore par défaut — ne le partagez PAS
# 3. Sur Vercel, configurez ces variables dans Project Settings > Environment Variables
# 4. BLOB_READ_WRITE_TOKEN est automatiquement injecté si vous liez votre Blob store au projet Vercel
